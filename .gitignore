# Ripen — gitignore

# dependencies
node_modules/

# next.js
.next/
out/

# env — JANGAN PERNAH commit ini
.env
.env*.local

# data mentah sumber vocab (cek lisensi sebelum commit apapun di sini)
data/*
!data/.gitkeep

# misc
.DS_Store
*.log
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/*.db

# python (scripts/_parse helper scripts)
__pycache__/
*.pyc
# tooling state
.commandcode/
.hermes/
